# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - EASYPANEL / VPS PRÓPRIA
# DIM Platform (Digital Influencer Management)
# ==============================================================================

# --- AMBIENTE GERAL ---
NODE_ENV=production
APP_ENV=production

# --- DOMÍNIOS E ROTAS ---
# Endereço público do frontend Web (ex: https://dim.seudominio.com)
WEB_ORIGIN=https://dim.seudominio.com

# URL interna usada pelo Next.js (dim-web) para falar com a API (dim-api) dentro da rede Docker
# No modo Docker Compose use: http://dim-api:3001
# Se usar Apps individuais com porta interna no Easypanel, use o nome do serviço ou URL interna
API_INTERNAL_URL=http://dim-api:3001

# --- BANCO DE DADOS POSTGRESQL (SUPABASE / SELF-HOSTED) ---
# String de conexão direta ou via pooler do PostgreSQL (Supabase ou Postgres do Easypanel)
# Exemplo Supabase: postgresql://postgres:[SENHA]@[HOST]:5432/postgres?sslmode=disable
# Exemplo Easypanel Postgres nativo: postgres://postgres:senha@dim-postgres:5432/dim
DATABASE_URL=postgresql://postgres:SUA_SENHA@SEU_HOST_POSTGRES:5432/postgres?sslmode=disable

# Executar migrações do schema automaticamente ao subir a API (true/false)
AUTO_MIGRATE=true

# --- SUPABASE AUTH & STORAGE ---
# URL da sua instância Supabase (ex: https://supabase-control-tower-api.fbr.news)
SUPABASE_URL=https://supabase-control-tower-api.fbr.news
NEXT_PUBLIC_SUPABASE_URL=https://supabase-control-tower-api.fbr.news

# Chaves de API do Supabase (obtidas no painel de configurações do Supabase)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ID fixo do projeto / tenant padrão
PROJECT_ID=3a4d3421-7d76-421c-afe2-e981e12ef64b

# Caminho do proxy da API no client frontend
NEXT_PUBLIC_API_URL=/api/v1

# --- FILA E CACHE (REDIS) ---
# Se estiver usando o serviço dim-redis do docker-compose:
REDIS_URL=redis://dim-redis:6379
# Se estiver usando um serviço Redis separado do Easypanel:
# REDIS_URL=redis://default:senha@dim-redis:6379

# --- COFRE DE SEGREDOS (HASHICORP VAULT / MOCK / CENTRAL) ---
VAULT_ADDR=http://vault.fbr.news:8200
VAULT_TOKEN=hvs.SEU_TOKEN_DO_VAULT
VAULT_MOUNT=secret

# --- INTEGRAÇÃO COM MOTOR N8N ---
# URL da instância n8n instalada na VPS ou Easypanel
N8N_URL=https://n8n.fbr.news
N8N_SERVICE_TOKEN=seu_token_secreto_de_comunicacao_com_n8n

# --- WEBHOOKS E PROVEDORES DE REDE SOCIAL ---
TELEGRAM_WEBHOOK_SECRET=token_secreto_telegram
WHATSAPP_APP_SECRET=meta_app_secret
WHATSAPP_VERIFY_TOKEN=token_verificacao_webhook_whatsapp
WHATSAPP_GRAPH_VERSION=v22.0

X_CLIENT_ID=client_id_do_x_twitter
X_CLIENT_SECRET=client_secret_do_x_twitter
X_REDIRECT_URI=https://dim.seudominio.com/api/v1/auth/callback/x

# --- ANTIVÍRUS CLAMAV (OPCIONAL) ---
# Se possuir o container ClamAV rodando na VPS
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- LIMITES DE TAXA (RATE LIMITS) ---
PROVIDER_RATE_PER_SECOND=5
ACCOUNT_RATE_PER_MINUTE=10
